@model PhoneStore.Web.Models.Product
@{
    ViewData["Title"] = "Thêm điện thoại mới";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách</a>
</div>

<div class="admin-card border-top border-4 border-warning mx-auto" style="max-width: 900px;">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="header-icon-box icon-box-warning me-3">
            <i class="bi bi-plus-square-dotted"></i>
        </div>
        <div>
            <h4 class="fw-bold text-dark mb-1">Thêm điện thoại mới</h4>
            <span class="text-muted small">Nhập đầy đủ thông số kỹ thuật và giá bán cho sản phẩm</span>
        </div>
    </div>

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold small text-secondary">Tên điện thoại *</label>
            <input asp-for="Name" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: iPhone 16 Pro Max 256GB" required />
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Hãng sản xuất *</label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select bg-light border-0 shadow-sm py-2"></select>
            </div>
            <div class="col-md-6">
                <label class="form-label fw-semibold small text-secondary">Giá bán (VNĐ) *</label>
                <input asp-for="Price" type="number" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: 24990000" required />
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">RAM</label>
                <input asp-for="RAM" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: 8GB" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">Bộ nhớ trong</label>
                <input asp-for="Storage" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: 256GB" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">Màu sắc</label>
                <input asp-for="Color" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: Titan Sa Mạc" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small text-secondary">Tồn kho *</label>
                <input asp-for="StockQuantity" type="number" class="form-control bg-light border-0 shadow-sm py-2" placeholder="VD: 10" required />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold small text-secondary">Đường dẫn hình ảnh (URL) *</label>
            <input asp-for="ImageUrl" class="form-control bg-light border-0 shadow-sm py-2" placeholder="https://..." required />
        </div>

        <div class="mb-4">
            <label class="form-label fw-semibold small text-secondary">Mô tả chi tiết</label>
            <textarea asp-for="Description" class="form-control bg-light border-0 shadow-sm py-2" rows="4" placeholder="Nhập điểm nổi bật của máy..."></textarea>
        </div>

        <div class="d-flex gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-save me-1"></i> Lưu thông tin
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 border text-dark fw-medium">Hủy</a>
        </div>
    </form>
</div>