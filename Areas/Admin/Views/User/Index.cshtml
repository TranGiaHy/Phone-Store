@model IEnumerable<PhoneStore.Web.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý Tài khoản";
    var userRoles = ViewBag.UserRoles as Dictionary<string, string>;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <!-- Khối Tiêu đề (Màu Tím) -->
    <div class="d-flex align-items-center">
        <div class="header-icon-box icon-box-purple me-3">
            <i class="bi bi-people-fill"></i>
        </div>
        <div>
            <h3 class="fw-bold text-dark mb-1">Quản lý Tài khoản Người dùng</h3>
            <span class="text-muted small">Quản lý phân quyền, cấp lại mật khẩu và khóa bảo vệ</span>
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill px-4 py-2 shadow-sm mt-3 mt-md-0">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm tài khoản mới
    </a>
</div>

<div class="admin-card p-4">
    <div class="admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Email / Tên đăng nhập</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò (Role)</th>
                    <th>Bảo mật</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    string role = userRoles != null && userRoles.ContainsKey(u.Id) ? userRoles[u.Id] : "Customer";
                    bool isLocked = u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.UtcNow;

                    <tr>
                        <td>
                            <div class="fw-bold text-dark fs-6 mb-1">
                                <i class="bi bi-person-circle me-1 text-secondary"></i> @u.Email
                            </div>
                            <small class="text-muted">ID: @u.Id.Substring(0, 8)...</small>
                        </td>
                        <td class="text-muted">@(string.IsNullOrEmpty(u.PhoneNumber) ? "Chưa cập nhật" : u.PhoneNumber)</td>
                        <td>
                            @if (role == "Admin")
                            {
                                <span class="badge badge-soft-danger rounded-pill px-3 py-1"><i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-info rounded-pill px-3 py-1"><i class="bi bi-person-fill me-1"></i>Khách hàng</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border font-monospace px-2 py-1">
                                <i class="bi bi-key-fill text-warning me-1"></i> Đã mã hóa
                            </span>
                        </td>
                        <td>
                            @if (isLocked)
                            {
                                <span class="badge badge-soft-warning px-3 py-1"><i class="bi bi-lock-fill"></i> Bị khóa</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-success px-3 py-1"><i class="bi bi-check-circle-fill"></i> Hoạt động</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary btn-admin-action mb-1 mb-sm-0">
                                <i class="bi bi-pencil-square"></i> Sửa / Reset MK
                            </a>

                            @if (u.UserName != User.Identity?.Name)
                            {
                                <form asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn @(isLocked ? "btn-outline-success" : "btn-outline-warning") btn-admin-action mb-1 mb-sm-0 ms-1">
                                        <i class="bi @(isLocked ? "bi-unlock-fill" : "bi-lock-fill")"></i> @(isLocked ? "Mở khóa" : "Khóa")
                                    </button>
                                </form>

                                <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @u.Email không?');">
                                    <button type="submit" class="btn btn-outline-danger btn-admin-action ms-1">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>