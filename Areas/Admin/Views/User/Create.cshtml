@{
    ViewData["Title"] = "Thêm Tài khoản mới";
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted fw-medium"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách tài khoản</a>
</div>

<div class="admin-card border-top border-4 border-purple mx-auto" style="max-width: 600px; border-top-color: #a855f7 !important;">
    <!-- Header -->
    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
        <div class="header-icon-box icon-box-purple me-3">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h4 class="fw-bold text-dark mb-1">Tạo Tài khoản Người dùng mới</h4>
            <span class="text-muted small">Thiết lập thông tin và phân quyền truy cập</span>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3 shadow-sm py-2 small"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]</div>
    }

    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold small text-secondary">Email (Tên đăng nhập) *</label>
            <input type="email" name="email" class="form-control bg-light border-0 shadow-sm py-2" placeholder="khachhang@gmail.com" required />
        </div>
        
        <div class="mb-3">
            <label class="form-label fw-semibold small text-secondary">Số điện thoại</label>
            <input type="text" name="phoneNumber" class="form-control bg-light border-0 shadow-sm py-2" placeholder="0901234567" />
        </div>
        
        <div class="mb-3">
            <label class="form-label fw-semibold small text-secondary">Mật khẩu khởi tạo * (Tối thiểu 6 ký tự)</label>
            <input type="text" name="password" class="form-control bg-light border-0 shadow-sm py-2" placeholder="Nhập mật khẩu..." minlength="6" required />
            <small class="text-muted d-block mt-1"><i class="bi bi-shield-check text-success me-1"></i>Mật khẩu sẽ tự động được mã hóa bảo mật sau khi lưu.</small>
        </div>
        
        <div class="mb-4">
            <label class="form-label fw-semibold small text-secondary">Phân quyền hệ thống *</label>
            <select name="role" class="form-select bg-light border-0 shadow-sm py-2">
                <option value="Customer">Khách hàng (Customer)</option>
                <option value="Admin">Quản trị viên (Admin)</option>
            </select>
        </div>
        
        <div class="d-flex gap-2 pt-3 border-top">
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                <i class="bi bi-check-lg me-1"></i> Tạo tài khoản
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 border text-dark fw-medium">Hủy</a>
        </div>
    </form>
</div>