@model List<PhoneStore.Web.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ hàng của bạn";
    decimal grandTotal = Model.Sum(item => item.Total);
}

<h2 class="mb-4">🛒 Giỏ hàng của bạn</h2>

@if (!Model.Any())
{
    <div class="alert alert-info py-4 text-center">
        <h5>Giỏ hàng đang trống!</h5>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Tiếp tục mua sắm</a>
    </div>
}
else
{
    // Hiển thị thông báo lỗi từ Backend nếu có
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger mb-3">
            @TempData["ErrorMessage"]
        </div>
    }

    <table class="table table-hover align-middle bg-white shadow-sm rounded">
        <thead class="table-light">
            <tr>
                <th>Sản phẩm</th>
                <th>Đơn giá</th>
                <th style="width: 160px;">Số lượng</th>
                <th>Thành tiền</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <img src="@item.ImageUrl" alt="@item.ProductName" style="width: 60px; height: 60px; object-fit: contain;" />
                            <strong>@item.ProductName</strong>
                        </div>
                    </td>
                    <td>@item.Price.ToString("N0") ₫</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            
                            <!-- Đổi Input thành Dropdown từ 1 đến 5 -->
                            <select name="quantity" class="form-select form-select-sm" style="width: 80px;" onchange="this.form.submit()">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i == item.Quantity)
                                    {
                                        <option value="@i" selected>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                            
                            <noscript>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Cập nhật</button>
                            </noscript>
                        </form>
                    </td>
                    <td class="text-danger fw-bold">@item.Total.ToString("N0") ₫</td>
                    <td>
                        <a asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center mt-4 p-3 bg-light rounded shadow-sm">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">← Tiếp tục mua hàng</a>
        <div class="text-end">
            <h4>Tổng cộng: <span class="text-danger fw-bold">@grandTotal.ToString("N0") ₫</span></h4>
            <a asp-action="Checkout" class="btn btn-success btn-lg mt-2">Tiến hành Thanh toán →</a>
        </div>
    </div>
}