<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhoneStore Chính Hãng VN/A</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Thanh Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-store py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2 text-white" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="bg-danger text-white rounded-3 px-2 py-1 d-inline-flex align-items-center">
                        <i class="bi bi-phone-vibrate-fill fs-5"></i>
                    </span>
                    <span>Phone<span class="text-warning">Store</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="MyOrders">
                                    <i class="bi bi-receipt me-1"></i> Tra cứu đơn hàng
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Quản trị (Admin)
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="btn btn-cart-header px-3 py-2 btn-sm" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag-check-fill me-1 text-warning"></i> Giỏ hàng
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item ms-lg-2">
                                <span class="text-light small"><i class="bi bi-person-check-fill text-info me-1"></i>Xin chào, <strong>@User.Identity.Name</strong></span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-danger rounded-3 px-3 py-1 ms-1" asp-area="" asp-controller="Account" asp-action="Logout">Đăng xuất</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light rounded-3 px-3 py-2" asp-area="" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-warning fw-semibold rounded-3 px-3 py-2 text-dark" asp-area="" asp-controller="Account" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Nội dung chính -->
    <div class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Chân trang (Footer) -->
    <footer class="bg-dark text-white-50 pt-5 pb-4 mt-auto border-top">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom border-secondary">
                <div class="col-md-4">
                    <h5 class="text-white fw-bold mb-3"><i class="bi bi-phone-vibrate-fill text-warning me-2"></i>PhoneStore Vietnam</h5>
                    <p class="small mb-2">Hệ thống bán lẻ điện thoại di động chính hãng Apple, Samsung, Xiaomi uy tín hàng đầu với mức giá tốt nhất.</p>
                    <div class="small text-white"><i class="bi bi-geo-alt-fill text-danger me-1"></i> TP. Hồ Chí Minh, Việt Nam</div>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">Chính sách & Hỗ trợ</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
                        <li><i class="bi bi-check2 text-warning me-1"></i> Bảo hành chính hãng 12 tháng toàn quốc</li>
                        <li><i class="bi bi-check2 text-warning me-1"></i> 1 đổi 1 trong 30 ngày nếu lỗi nhà sản xuất</li>
                        <li><i class="bi bi-check2 text-warning me-1"></i> Trả góp 0% lãi suất qua thẻ tín dụng</li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">Tổng đài hỗ trợ miễn phí</h6>
                    <div class="small mb-2">Gọi mua hàng: <strong class="text-warning fs-6">+84794467058</strong> (8h00 - 22h00)</div>
                    <div class="small mb-2">Khiếu nại, bảo hành: <strong class="text-info fs-6">+84794467058</strong> (8h30 - 21h00)</div>
                </div>
            </div>
            <div class="text-center small pt-3">
                © 2026 PhoneStore. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>